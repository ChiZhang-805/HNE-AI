{
  "version": "hne-continuous-latent-v1",
  "datasets": ["RESILIENT", "BrisT1D-Open"],
  "variants": ["recurrent", "single_pass", "reset_feedback"],
  "seeds": [20261114, 20261115, 20261116],
  "folds": [0, 1, 2, 3, 4],
  "latent_steps": 4,
  "use_kv_cache": true,
  "frozen_prefix_blocks": 10,
  "recurrent_core_blocks": 2,
  "hidden_width": 64,
  "lora_rank": 8,
  "context_channels": 1,
  "dropout": 0.1,
  "learning_rate": 0.0003,
  "lora_learning_rate": 0.00003,
  "weight_decay": 0.05,
  "batch_size": 32,
  "micro_batch_size": 32,
  "evaluation_batch_size": 32,
  "people_per_batch": 4,
  "maximum_epochs": 32,
  "minimum_epochs": 8,
  "patience": 8,
  "plateau_patience": 3,
  "intermediate_loss_weight": 0.1,
  "future_loss_weight": 0.02,
  "selection": "three participant folds inside original training split; pair-weighted AUROC; refit original training participants with selected epochs",
  "training": "equal participant sampling; equal event class mass; fully differentiable feedback through all four steps",
  "evaluation": "participant-separated five folds; same input origins and labels as DNB, FCM, CATCH",
  "references": ["https://arxiv.org/abs/2412.06769", "https://github.com/facebookresearch/coconut", "https://arxiv.org/abs/2502.05171"]
}
