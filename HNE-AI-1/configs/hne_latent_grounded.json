{
  "version": "hne-evidence-conditioned-core-v1",
  "datasets": [
    "RESILIENT",
    "BrisT1D-Open"
  ],
  "variants": [
    "recurrent",
    "no_modulation",
    "clock_only_modulation",
    "final_future_only",
    "reset_feedback",
    "single_pass"
  ],
  "seeds": [
    20261114,
    20261115,
    20261116
  ],
  "folds": [
    0,
    1,
    2,
    3,
    4
  ],
  "latent_steps": 4,
