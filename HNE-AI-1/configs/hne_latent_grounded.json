  "future_loss_weight": 0.02,
  "selection": "three participant folds inside original training split; pair-weighted AUROC; refit original training participants with selected epochs",
  "training": "participant-balanced sampling; class-weighted BCE; dense future-summary decoding; evidence/state/time-conditioned internal modulation; full feedback gradient",
  "evaluation": "participant-separated five folds; same input origins and labels as DNB, FCM, CATCH",
  "references": [
    "https://openreview.net/forum?id=Itxz7S4Ip3",
    "https://openreview.net/forum?id=RzYXb5YWBs",
    "https://proceedings.iclr.cc/paper_files/paper/2026/hash/5d087955ee13fe9a7402eedec879b9c3-Abstract-Conference.html",
