  "validation": "participant-balanced pooled AUROC (inverse per-person sample count); tie broken by lower BCE",
  "folds": [0, 1, 2, 3, 4],
  "validation_fold": "(held_fold+1)%5",
  "primary_metric": "within-fold pair-weighted AUROC",
  "secondary_metrics": ["AUPRC", "balanced_accuracy", "sensitivity_at_10pct_FPR", "Brier"],
  "baseline_epochs": 20,
  "baseline_batch_size": 8,
  "selection": "each fold chooses LR on validation with first seed, then runs all three seeds at chosen LR",
  "rq1": "模型能否学习多指标节律紊乱的前兆？",
  "rq2": "学习推理路径能否提升紊乱预警？",
