{
  "backbone": "amazon/chronos-2",
  "datasets": ["RESILIENT", "BrisT1D-Open"],
  "input_hours_per_step": 3,
  "history_days": 32,
  "reference_days": 56,
  "future_start_offset": 2,
  "future_end_offset": 8,
  "frozen_prefix_layers": 11,
  "trainable_tail_layers": 1,
  "lora_rank": 8,
  "hidden_width": 96,
  "reasoning_steps": 3,
  "actions": ["history", "network", "environment"],
  "seeds": [20261113, 20261114, 20261115],
  "learning_rates": [0.0003, 0.001],
  "epochs": 20,
  "batch_size": 16,
  "weight_decay": 0.01,
  "future_loss_weight": 0.1,
  "path_loss_weight": 0.1,
  "auxiliary_event_weight": 0.1,
  "router_temperature": 0.7,
  "path_policy_epochs": 40,
  "path_policy_learning_rate": 0.0003,
  "path_policy_temperature": 0.1,
  "path_policy_batch_size": 256,
  "backbone_revision": "29ec3766d36d6f73f0696f85560a422f50e8498c",
